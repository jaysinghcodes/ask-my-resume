{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "react-router-dom": ["frontend/node_modules/react-router-dom"]
    }
  },
  "include": [
    "api/**/*.js",
    "lib/**/*.js",
    "scripts/**/*.js",
    "tests/**/*.js",
    "tests/**/*.jsx",
    "types/**/*.d.ts",
    "frontend/src/**/*.js",
    "frontend/src/**/*.jsx",
    "frontend/vite.config.js"
  ]
}
