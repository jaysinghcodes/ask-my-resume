{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && npm install --prefix frontend",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev --prefix frontend -- --host 127.0.0.1 --port $PORT",
  "outputDirectory": "frontend/dist",
  "fluid": true,
  "functions": {
    "api/chat.js": {
      "maxDuration": 60,
      "includeFiles": "frontend/public/Jay-Singh-Resume-Oct-2026.pdf"
    },
    "api/health.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/((?!api/|favicon\\.ico|robots\\.txt|sitemap\\.xml|og-image\\.png|icon\\.svg|apple-touch-icon\\.png|assets/).*)", "destination": "/index.html" }
  ]
}
