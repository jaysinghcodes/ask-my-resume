{
  "$id": "https://ask-jay.local/schema/faqs.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "allOf": [
      { "$ref": "https://ask-jay.local/schema/common.json#/$defs/record" },
      { "$ref": "https://ask-jay.local/schema/common.json#/$defs/noPhone" },
      {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" },
          "cites": { "type": "array", "items": { "type": "string" } },
          "audience": { "type": "string" },
          "featured": { "type": "boolean" }
        }
      }
    ]
  }
}
