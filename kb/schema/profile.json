{
  "$id": "https://ask-jay.local/schema/profile.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    { "type": "null" },
    {
      "allOf": [
        { "$ref": "https://ask-jay.local/schema/common.json#/$defs/record" },
        { "$ref": "https://ask-jay.local/schema/common.json#/$defs/noPhone" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "full_name": { "type": "string" },
            "preferred_name": { "type": "string" },
            "display_name": { "type": "string" },
            "headline": { "type": "string" },
            "headline_support": { "type": "string" },
            "summary": { "type": "string" },
            "summary_third_person": { "type": "string" },
            "current_role": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "title": { "type": "string" },
                "employer": { "type": "string" },
                "role_id": { "type": "string" }
              }
            },
            "location": { "type": "string" },
            "timezone": { "type": "string" },
            "availability": { "type": "string" },
            "work_preferences": { "type": "string" },
            "contact_blurb": { "type": "string" },
            "growth_area": { "type": "string" },
            "work_authorization": { "type": "string" },
            "photo": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "path": { "type": "string" },
                "alt": { "type": "string" },
                "status": { "type": "string" }
              }
            },
            "links": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true }
            },
            "outside_work": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      ]
    }
  ]
}
