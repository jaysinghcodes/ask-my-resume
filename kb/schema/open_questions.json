{
  "$id": "https://ask-jay.local/schema/open_questions.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "allOf": [
      { "$ref": "https://ask-jay.local/schema/common.json#/$defs/record" },
      { "$ref": "https://ask-jay.local/schema/common.json#/$defs/noPhone" },
      {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "question": { "type": "string" },
          "affects": { "type": "string" },
          "answer": { "type": "string" },
          "status": { "type": "string" },
          "resolved_on": { "type": "string" }
        }
      }
    ]
  }
}
