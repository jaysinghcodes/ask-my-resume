{
  "$id": "https://ask-jay.local/schema/roles.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "allOf": [
      { "$ref": "https://ask-jay.local/schema/common.json#/$defs/record" },
      { "$ref": "https://ask-jay.local/schema/common.json#/$defs/noPhone" },
      {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "employer": { "type": "string" },
          "title": { "type": "string" },
          "employment_type": { "type": "string" },
          "location": { "type": "string" },
          "start": { "type": "string" },
          "end": { "type": "string" },
          "client_description": { "type": "string" },
          "stack": { "type": "array", "items": { "type": "string" } },
          "bullet_ids": { "type": "array", "items": { "type": "string" } },
          "summary": { "type": "string" },
          "scope": { "type": "string" },
          "worked_with": { "type": "string" },
          "learned": { "type": "string" },
          "learned_public": { "type": "boolean" },
          "why_joined_or_left": { "type": "string" },
          "unverified_claims": { "type": "array" },
          "confirmed_details": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          },
          "stack_note": { "type": "string" }
        }
      }
    ]
  }
}
