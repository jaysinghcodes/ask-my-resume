# API key from the Ask Jay workspace in the Anthropic console.
ANTHROPIC_API_KEY=

# Current Claude Sonnet model id. Required. The app has no default model.
MODEL_ID=

# Comma separated terms the knowledge base build rejects in public fields.
# Replace the placeholder with your list. The placeholder and a blank value skip the check with a warning.
KB_BANNED_TERMS=your_terms_here

# Optional caps. Empty values use the defaults shown here.
CHAT_MAX_HISTORY=12
CHAT_MAX_MESSAGE_CHARS=8000
CHAT_PER_IP_DAILY=30
CHAT_SITE_DAILY=500
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_REQUEST_TIMEOUT_SECONDS=60
CHAT_MAX_TOOL_ROUNDS=5

# Salt for visitor IP hashes. Set a long random string for Production and Preview.
# The function stores only the salted hash, and the key expires after 24 hours.
# In production, a missing salt keeps chat unavailable. Local development warns and uses a temporary salt.
# Daily caps reset at midnight UTC.
IP_HASH_SALT=

# Upstash Redis REST credentials from the Vercel Marketplace integration.
# The function reads this pair first.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Fallback pair some Vercel Upstash integrations write instead.
# Used only when the Upstash pair above is incomplete.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Preview host suffix. Empty uses the team default, -singh-solutions.vercel.app.
PREVIEW_HOST_SUFFIX=

# Optional comma separated origins for a custom domain.
# The production URL and preview URLs of this Vercel project are allowed without this.
ALLOWED_ORIGINS=
