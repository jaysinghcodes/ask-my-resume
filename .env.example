# API key from the Ask Jay workspace in the Anthropic console.
ANTHROPIC_API_KEY=

# Current Claude Sonnet model id. Required. The app has no default model.
MODEL_ID=

# Comma separated terms the knowledge base build rejects in public fields.
# Replace the placeholder with your list. A blank value skips the check with a warning.
KB_BANNED_TERMS=your_terms_here
